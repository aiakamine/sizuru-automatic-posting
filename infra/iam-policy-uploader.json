{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPutClipsUnderPublicPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_S3_BUCKET/REPLACE_WITH_S3_PUBLIC_PREFIX*"
    },
    {
      "Sid": "AllowReadOwnUploadsUnderPublicPrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:HeadObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_S3_BUCKET/REPLACE_WITH_S3_PUBLIC_PREFIX*"
    }
  ]
}
