# =============================================================================
# スキル利用者（mitchaku-kirinuki / taidan-kirinuki / sns-schedule を使うだけの人）
# =============================================================================
# 管理者から個別に受け取る値。他人と共有しない・コミットしない。
SIZURU_API_URL=https://4ynlgoe3h2.execute-api.ap-northeast-1.amazonaws.com
SIZURU_API_KEY=

# =============================================================================
# 以下は CLI・運用者のみ（sizuru-post CLI を直接動かす／Buffer・S3・Supabaseを
# 直接触る人向け）。スキル利用者は設定不要。
# =============================================================================

# Buffer (https://buffer.com) GraphQL API
BUFFER_API_KEY=
# Optional: defaults to the first organization returned by the Buffer API
BUFFER_ORGANIZATION_ID=

# AWS (used to upload video to S3 for a stable public URL Buffer can fetch)
AWS_PROFILE=
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_PUBLIC_PREFIX=public/

# Supabase (audit trail: channels / clips / posts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
