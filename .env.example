# Buffer (https://buffer.com) GraphQL API
BUFFER_API_KEY=
# Optional: defaults to the first organization returned by the Buffer API
BUFFER_ORGANIZATION_ID=

# AWS (used to upload video to S3 for a stable public URL Buffer can fetch)
AWS_PROFILE=
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_PUBLIC_PREFIX=public/

# Supabase (audit trail: channels / clips / posts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
